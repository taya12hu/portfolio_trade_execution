# Copy to .env and adjust. docker-compose reads it if present (all values have safe dev defaults).

# dev | test | prod. dev mounts /dev/webhook-sink and allows http callback URLs.
APP_ENV=dev
# DATABASE_URL is set by docker-compose for Postgres; for local runs without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db
LOG_LEVEL=INFO
LOG_JSON=true

# Consumers: "api_key:owner_id" pairs, comma separated.
API_KEYS=dev-key:demo-owner

# Fernet key for broker tokens at rest. REQUIRED outside dev. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# HMAC secret for X-Signature on webhooks.
WEBHOOK_SECRET=change-me

# Kill switch. Real broker adapters refuse to place orders unless this is true.
LIVE_TRADING_ENABLED=false

# Safety caps
MAX_QTY_PER_ORDER=100000
MAX_ORDERS_PER_EXECUTION=50

# Engine tuning
ORDER_MONITOR_TIMEOUT_S=60
POLL_INTERVAL_S=1
RECONCILE_ATTEMPTS=3
RECONCILE_DELAY_S=3
RECONCILE_CONFIRM_AFTER_S=120
BROKER_MAX_RETRIES=3

# Broker app credentials (the platform's registered app, not an end user's login).
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/broker-connections/upstox/callback
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=http://localhost:8000/broker-connections/fyers/callback
ANGELONE_API_KEY=
GROWW_API_KEY=
GROWW_API_SECRET=
